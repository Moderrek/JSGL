{
  "name": "@moderrkowo/jsgl",
  "description": "Client-side JavaScript library for creating web 2D games. Focusing at objective game.",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/jsgl.umd.js",
  "module": "./dist/jsgl.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/jsgl.es.js",
      "require": "./dist/jsgl.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "homepage": "https://moderrek.github.io/JSGLDoc/",
  "bugs": {
    "url": "https://github.com/Moderrek/JSGL/issues",
    "email": "tymon.student@gmail.com"
  },
  "author": "Tymon Woźniak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Moderrek/JSGL.git"
  },
  "keywords": [
    "game-development",
    "javascript",
    "javascript-game",
    "2d-game",
    "game-objects",
    "graphics",
    "canvas",
    "html",
    "animation",
    "library"
  ],
  "scripts": {
    "build:types": "tsc --emitDeclarationOnly",
    "build:docs": "typedoc src/index.ts --name \"JSGL\" --includeVersion --hideGenerator --logLevel Error",
    "build": "vite build && npm run build:docs",
    "dev": "vite build --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2"
  }
}
