{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "preserveConstEnums": true,
    "outDir": "./dist/",
    "strict": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"]
    },
  },
  "exclude": [
    "node_modules",
    "dist",
    "vite.config.ts"
  ],
  "include": [
    "src/**/*"
  ]
}